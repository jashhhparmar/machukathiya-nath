<section class="banner-section text-white text-center py-4" style="background: linear-gradient(135deg, #02362c, #046957);">
    <div class="container py-2">
        <h2 class="fw-bold mb-1">Family Details</h2>
        <p class="mb-0 opacity-75">Samaj Directory</p>
    </div>
</section>

<div class="container py-5">
    <div class="mb-4 d-flex justify-content-between align-items-center flex-wrap gap-2">
        <a href="/vastipatrak" class="text-decoration-none fw-semibold" style="color: #046957;">
            <i class="fas fa-arrow-left me-1"></i> Back to Vastipatrak
        </a>
    </div>

    <!-- Success / Error Messages -->
    <% if (locals.success) { %>
    <div class="alert alert-success alert-dismissible fade show shadow-sm" role="alert">
        <i class="fas fa-check-circle me-2"></i><%= success %>
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
    <% } %>
    <% if (locals.error) { %>
    <div class="alert alert-danger alert-dismissible fade show shadow-sm" role="alert">
        <i class="fas fa-exclamation-circle me-2"></i><%= error %>
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
    <% } %>

    <!-- Family Information Card -->
    <div class="card shadow-sm border-0 mb-5 rounded overflow-hidden">
        <div class="card-header text-white py-3 border-0 d-flex justify-content-between align-items-center" style="background-color: #046957;">
            <h5 class="mb-0 fw-bold"><i class="fas fa-users me-2"></i> Family Information</h5>
            <% if (locals.isAdmin) { %>
            <button type="button" class="btn btn-outline-light btn-sm fw-semibold" data-bs-toggle="modal" data-bs-target="#deleteFamilyModal">
                <i class="fas fa-trash-alt me-1"></i> Delete Family
            </button>
            <% } %>
        </div>
        <div class="card-body p-4 bg-white">
            <div class="row align-items-center text-center text-md-start">
                <div class="col-md-2 mb-3 mb-md-0 d-flex justify-content-center">
                    <div class="rounded-circle d-flex align-items-center justify-content-center shadow-sm" style="width: 80px; height: 80px; background-color: #f8f9fa;">
                        <i class="fas fa-home fa-2x" style="color: #046957;"></i>
                    </div>
                </div>
                <div class="col-md-10">
                    <div class="row text-center text-md-start g-3">
                        <div class="col-sm-3">
                            <div class="text-muted small text-uppercase fw-bold mb-1">Vastipatrak No</div>
                            <div class="fs-3 fw-bold" style="color: #046957;"><%= String(family.vastipatrakNo).padStart(4, '0') %></div>
                        </div>
                        <div class="col-sm-3">
                            <div class="text-muted small text-uppercase fw-bold mb-1">Village</div>
                            <div class="fs-5 fw-semibold"><%= family.village %></div>
                        </div>
                        <div class="col-sm-3">
                            <div class="text-muted small text-uppercase fw-bold mb-1">Mosal</div>
                            <div class="fs-5 fw-semibold"><%= family.mosal || '—' %></div>
                        </div>
                        <div class="col-sm-3">
                            <div class="text-muted small text-uppercase fw-bold mb-1">Total Members</div>
                            <div class="fs-5 fw-semibold"><%= family.totalMembers %></div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Add Member Button (for family owner, family members, or admin) -->
    <% if (locals.isFamilyMember || locals.isAdmin) { %>
    <div class="mb-4 text-end">
      <a href="/family/<%= family._id %>/add-member" class="btn text-white fw-semibold px-4" style="background-color:#046957; border-radius:8px;">
        <i class="fas fa-user-plus me-2"></i> Add Family Member
      </a>
    </div>
    <% } %>

    <!-- Family Members List -->
    <h4 class="fw-bold mb-4" style="color: #046957;">Family Members</h4>
    
    <div class="row row-cols-1 row-cols-sm-2 row-cols-md-3 row-cols-lg-4 g-4 mb-5">
        <% if (locals.members && members.length > 0) { %>
            <% members.forEach(member => { %>
                <div class="col">
                    <div class="card h-100 shadow-sm border-0 d-flex flex-column" style="border-radius: 10px; transition: transform 0.2s;" onmouseover="this.style.transform='translateY(-5px)'" onmouseout="this.style.transform='translateY(0)'">
                        <div class="card-body text-center d-flex flex-column flex-grow-1 p-3">
                            <!-- Photo -->
                            <div class="mb-3">
                                <img src="<%= member.profilePhoto || '/images/no-profile.svg' %>" alt="Profile" class="rounded-circle shadow-sm" style="width: 80px; height: 80px; object-fit: cover; border: 2px solid #eee;">
                            </div>
                            
                            <!-- Name -->
                            <h5 class="fw-bold text-dark mb-2"><%= member.fullName %></h5>
                            
                            <!-- Badges -->
                            <div class="mb-3 d-flex flex-wrap justify-content-center gap-1">
                                <span class="badge border text-dark fw-normal bg-light"><%= member.relation %></span>
                                <% if (member.membershipType === 'Life Member') { %>
                                    <span class="badge text-white fw-normal" style="background-color: #046957;"><%= member.membershipType %></span>
                                <% } else { %>
                                    <span class="badge bg-primary text-white fw-normal"><%= member.membershipType || 'Member' %></span>
                                <% } %>
                                <% if (member.bloodGroup) { %>
                                    <span class="badge bg-danger text-white fw-normal"><i class="fas fa-tint me-1"></i><%= member.bloodGroup %></span>
                                <% } %>
                                <% if (member.address && member.address.suburb) { %>
                                    <span class="badge bg-warning text-dark fw-normal"><i class="fas fa-building me-1"></i><%= member.address.suburb %></span>
                                <% } %>
                            </div>
                            
                            <!-- Info -->
                            <div class="text-start small text-muted mb-3 flex-grow-1">
                                <% if (member.phone) { %>
                                    <div class="mb-1"><i class="fas fa-phone fa-fw me-1 text-secondary"></i> <%= member.phone %></div>
                                <% } %>
                                <% if (member.occupation) { %>
                                    <div class="mb-1"><i class="fas fa-briefcase fa-fw me-1 text-secondary"></i> <%= member.occupation %></div>
                                <% } %>
                                <% if (member.education) { %>
                                    <div class="mb-1"><i class="fas fa-graduation-cap fa-fw me-1 text-secondary"></i> <%= member.education %></div>
                                <% } %>
                                <div class="mb-1"><i class="fas fa-user fa-fw me-1 text-secondary"></i> <%= member.gender %> &bull; <%= member.maritalStatus %></div>
                                <% if (member.dateOfBirth) { %>
                                    <div class="mb-1"><i class="fas fa-birthday-cake fa-fw me-1 text-secondary"></i> <%= new Date(member.dateOfBirth).toLocaleDateString('en-IN', {day:'2-digit', month:'short', year:'numeric'}) %></div>
                                <% } %>
                            </div>
                        </div>
                        
                        <!-- Address -->
                        <div class="card-footer bg-white border-top p-3 mt-auto">
                            <div class="small text-muted text-uppercase fw-bold mb-1" style="font-size: 0.75rem;"><i class="fas fa-map-marker-alt me-1"></i> Address / Suburb</div>
                            <div class="small text-dark lh-sm">
                                <% if (member.address) { %>
                                    <% if (member.address.line1) { %><div><%= member.address.line1 %></div><% } %>
                                    <% if (member.address.suburb) { %><div class="fw-semibold text-success"><i class="fas fa-city me-1"></i>Suburb: <%= member.address.suburb %></div><% } %>
                                    <div>
                                        <%= member.address.city || '' %><%= member.address.state ? ', ' + member.address.state : '' %><%= member.address.pincode ? ' - ' + member.address.pincode : '' %>
                                    </div>
                                    <% if (member.address.country) { %><div><%= member.address.country %></div><% } %>
                                <% } else { %>
                                    N/A
                                <% } %>
                            </div>
                        </div>
                        
                        <!-- Action Buttons -->
                        <% 
                          const canOwnerEdit = (locals.user && family.createdBy && family.createdBy.toString() === user._id.toString());
                          const canFamilyEdit = locals.isFamilyMember;
                          const canAdminEdit = locals.isAdmin;
                          const canEdit = canOwnerEdit || canFamilyEdit || canAdminEdit;
                          const canDelete = canOwnerEdit || canAdminEdit;
                          const canMakeHead = canFamilyEdit || canAdminEdit;
                        %>
                        <% if (canEdit) { %>
                        <div class="card-footer bg-light border-top p-2 text-center d-flex flex-wrap justify-content-center gap-2">
                            <a href="/family/<%= family._id %>/member/<%= member._id %>/edit" class="btn btn-sm fw-semibold px-3" style="background-color: #046957; color: white; border-radius: 6px;">
                                <i class="fas fa-edit me-1"></i> Edit
                            </a>
                            <% if (canMakeHead && member.relation !== 'SELF') { %>
                            <form action="/family/<%= family._id %>/member/<%= member._id %>/make-head" method="POST" class="d-inline">
                              <button type="submit" class="btn btn-sm btn-warning fw-semibold px-3" style="border-radius: 6px;" onclick="return confirm('Make <%= member.fullName %> the Family Head? The current head will lose their SELF status.')">
                                <i class="fas fa-crown me-1"></i> Make Head
                              </button>
                            </form>
                            <% } %>
                            <% if (canDelete && member.relation !== 'SELF') { %>
                            <button type="button" class="btn btn-sm btn-outline-danger fw-semibold px-3" style="border-radius: 6px;"
                                onclick="showDeleteMemberModal('<%= member._id %>', '<%= member.fullName %>', '<%= family._id %>', '<%= member.relation %>')">
                                <i class="fas fa-trash-alt me-1"></i> Delete
                            </button>
                            <% } %>
                        </div>
                        <% } %>
                    </div>
                </div>
            <% }) %>
        <% } else { %>
            <div class="col-12 text-center text-muted py-4">No members found for this family.</div>
        <% } %>
    </div>
</div>

<!-- ═══════════════════════════════════════════════════════════════════════════ -->
<!-- DELETE FAMILY MODAL (Admin Only) -->
<!-- ═══════════════════════════════════════════════════════════════════════════ -->
<% if (locals.isAdmin) { %>
<div class="modal fade" id="deleteFamilyModal" tabindex="-1" aria-labelledby="deleteFamilyModalLabel" aria-hidden="true">
  <div class="modal-dialog modal-dialog-centered">
    <div class="modal-content border-0 shadow">
      <div class="modal-header bg-danger text-white border-0">
        <h5 class="modal-title fw-bold" id="deleteFamilyModalLabel">
          <i class="fas fa-exclamation-triangle me-2"></i> Delete Entire Family
        </h5>
        <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
      </div>
      <div class="modal-body p-4">
        <div class="text-center mb-3">
          <i class="fas fa-trash-alt fa-3x text-danger mb-3"></i>
        </div>
        <p class="text-center mb-1">You are about to permanently delete the family:</p>
        <h5 class="text-center fw-bold text-danger mb-2"><%= family.familyHead %></h5>
        <p class="text-center text-muted small mb-3">Vastipatrak #<%= String(family.vastipatrakNo).padStart(4, '0') %> &bull; <%= family.totalMembers %> member(s)</p>
        <div class="alert alert-warning small mb-0">
          <i class="fas fa-exclamation-circle me-1"></i>
          <strong>Warning:</strong> This action will permanently delete the family and <strong>all its members</strong>. This cannot be undone.
        </div>
      </div>
      <div class="modal-footer border-0 d-flex justify-content-between">
        <button type="button" class="btn btn-secondary fw-semibold px-4" data-bs-dismiss="modal">Cancel</button>
        <form action="/admin/family/<%= family._id %>/delete" method="POST" style="display: inline;">
          <button type="submit" class="btn btn-danger fw-semibold px-4">
            <i class="fas fa-trash-alt me-1"></i> Yes, Delete Family
          </button>
        </form>
      </div>
    </div>
  </div>
</div>
<% } %>

<!-- ═══════════════════════════════════════════════════════════════════════════ -->
<!-- DELETE MEMBER MODAL (Family Owner + Admin) -->
<!-- ═══════════════════════════════════════════════════════════════════════════ -->
<div class="modal fade" id="deleteMemberModal" tabindex="-1" aria-labelledby="deleteMemberModalLabel" aria-hidden="true">
  <div class="modal-dialog modal-dialog-centered">
    <div class="modal-content border-0 shadow">
      <div class="modal-header bg-danger text-white border-0">
        <h5 class="modal-title fw-bold" id="deleteMemberModalLabel">
          <i class="fas fa-user-times me-2"></i> Delete Member
        </h5>
        <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
      </div>
      <div class="modal-body p-4">
        <div class="text-center mb-3">
          <i class="fas fa-user-times fa-3x text-danger mb-3"></i>
        </div>
        <p class="text-center mb-1">You are about to permanently delete:</p>
        <h5 class="text-center fw-bold text-danger mb-2" id="deleteMemberName"></h5>
        <div class="alert alert-warning small mb-0">
          <i class="fas fa-exclamation-circle me-1"></i>
          <strong>Warning:</strong> This action will permanently remove this member from the family. This cannot be undone.
        </div>
      </div>
      <div class="modal-footer border-0 d-flex justify-content-between">
        <button type="button" class="btn btn-secondary fw-semibold px-4" data-bs-dismiss="modal">Cancel</button>
        <form id="deleteMemberForm" action="" method="POST" style="display: inline;">
          <button type="submit" class="btn btn-danger fw-semibold px-4">
            <i class="fas fa-trash-alt me-1"></i> Yes, Delete Member
          </button>
        </form>
      </div>
    </div>
  </div>
</div>

<script>
function showDeleteMemberModal(memberId, memberName, familyId, relation) {
  // For non-admin users, prevent deleting the SELF member
  <% if (!locals.isAdmin) { %>
  if (relation === 'SELF') {
    alert('Cannot delete the family head. Please contact admin to remove the entire family.');
    return;
  }
  <% } %>

  document.getElementById('deleteMemberName').textContent = memberName;
  document.getElementById('deleteMemberForm').action = '/family/' + familyId + '/member/' + memberId + '/delete';
  
  var modal = new bootstrap.Modal(document.getElementById('deleteMemberModal'));
  modal.show();
}
</script>
