<div class="container py-5">
    <div class="card mx-auto shadow border-0" style="max-width: 450px; border-radius: 10px; overflow: hidden;">
        <div class="card-header text-white text-center py-3" style="background-color: #046957;">
            <h4 class="mb-0 fw-bold"><i class="fas fa-shield-alt me-2"></i> Verify OTP</h4>
            <p class="mb-0 small opacity-75 mt-1">Enter the 6-digit code sent to your email</p>
        </div>
        <div class="card-body p-4 bg-white">
            <% if (locals.errors && errors.length > 0) { %>
                <% errors.forEach(err => { %>
                    <div class="alert alert-danger py-2 small"><i class="fas fa-exclamation-circle me-1"></i><%= err.msg || err %></div>
                <% }) %>
            <% } %>

            <div class="text-center mb-4">
                <div class="d-inline-flex align-items-center justify-content-center rounded-circle" style="width: 70px; height: 70px; background: rgba(4,105,87,0.1);">
                    <i class="fas fa-mobile-alt fa-2x" style="color: #046957;"></i>
                </div>
                <p class="text-muted small mt-3">
                    We sent a verification code to<br>
                    <strong style="color: #046957;"><%= locals.email || 'your email' %></strong>
                </p>
            </div>

            <form action="/verify-otp" method="POST">
                <input type="hidden" name="email" value="<%= locals.email || '' %>">
                <div class="mb-4">
                    <label class="form-label fw-semibold text-muted">Enter OTP Code</label>
                    <div class="input-group">
                        <span class="input-group-text bg-light"><i class="fas fa-key text-secondary"></i></span>
                        <input type="text" name="otp" class="form-control text-center fw-bold" 
                               required placeholder="• • • • • •" 
                               maxlength="6" pattern="[0-9]{6}"
                               style="font-size: 1.3rem; letter-spacing: 6px;">
                    </div>
                </div>

                <!-- Countdown Timer -->
                <div class="text-center mb-3">
                    <span class="badge bg-light text-muted border px-3 py-2" id="otpTimer">
                        <i class="fas fa-clock me-1"></i> OTP valid for <span id="countdown">10:00</span>
                    </span>
                </div>
                
                <button type="submit" class="btn text-white w-100 py-2 fw-bold" style="background-color: #046957;">
                    <i class="fas fa-check-circle me-2"></i>Verify OTP
                </button>
            </form>

            <div class="text-center mt-3">
                <form action="/forgot-password" method="POST" class="d-inline">
                    <input type="hidden" name="email" value="<%= locals.email || '' %>">
                    <button type="submit" class="btn btn-link text-decoration-none p-0" style="color: #046957; font-size: 0.9rem;">
                        <i class="fas fa-redo me-1"></i> Resend OTP
                    </button>
                </form>
            </div>
            
            <div class="text-center mt-3">
                <a href="/login" class="text-decoration-none text-muted small">
                    <i class="fas fa-arrow-left me-1"></i> Back to Login
                </a>
            </div>
        </div>
    </div>
</div>

<script>
// Countdown timer for OTP validity (10 minutes)
(function() {
    let timeLeft = 600; // 10 minutes in seconds
    const countdownEl = document.getElementById('countdown');
    const timerEl = document.getElementById('otpTimer');
    
    const timer = setInterval(() => {
        timeLeft--;
        const minutes = Math.floor(timeLeft / 60);
        const seconds = timeLeft % 60;
        countdownEl.textContent = `${minutes}:${seconds.toString().padStart(2, '0')}`;
        
        if (timeLeft <= 60) {
            timerEl.classList.remove('bg-light', 'text-muted');
            timerEl.classList.add('bg-danger', 'bg-opacity-10', 'text-danger');
        }
        
        if (timeLeft <= 0) {
            clearInterval(timer);
            countdownEl.textContent = 'Expired';
            timerEl.classList.add('text-danger');
        }
    }, 1000);
})();
</script>
