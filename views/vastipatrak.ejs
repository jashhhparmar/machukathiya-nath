<section class="banner-section text-white text-center py-4" style="background: linear-gradient(135deg, #02362c, #046957);">
    <div class="container py-3">
        <h1 class="fw-bold mb-0"><i class="fas fa-search me-2"></i>Vastipatrak Directory & Global Search</h1>
        <p class="mb-0 opacity-75">Search across members, occupations, suburbs, villages, and families</p>
    </div>
</section>

<div class="container py-5">
    <!-- Search Bar -->
    <div class="row justify-content-center mb-4">
        <div class="col-md-8">
            <form action="/vastipatrak" method="GET" class="d-flex bg-white p-2 rounded shadow-sm border">
                <div class="input-group border-0">
                    <span class="input-group-text bg-white border-0"><i class="fas fa-search text-success"></i></span>
                    <input type="text" name="search" class="form-control border-0 shadow-none" placeholder="Search by occupation (e.g. Engineer), name, suburb, village, phone..." value="<%= locals.search || '' %>">
                </div>
                <button type="submit" class="btn text-white px-4 fw-bold" style="background-color: #046957;">Search</button>
            </form>
            <% if (locals.search) { %>
                <div class="text-center mt-2">
                    <span class="text-muted">Search results for keyword: <strong class="text-dark">"<%= search %>"</strong></span>
                    <a href="/vastipatrak" class="text-danger ms-2 text-decoration-none small fw-bold"><i class="fas fa-times-circle"></i> Clear Search</a>
                </div>
            <% } %>
        </div>
    </div>

    <% if (locals.search) { %>
        <!-- Search Summary -->
        <div class="alert alert-light border shadow-sm mb-4 d-flex justify-content-between align-items-center flex-wrap gap-2">
            <div>
                <i class="fas fa-info-circle text-success me-2"></i>
                Found <strong><%= locals.matchedMembersCount || 0 %></strong> matching member(s) and <strong><%= locals.totalFamilies || 0 %></strong> family record(s).
            </div>
        </div>

        <!-- Matched Members Section -->
        <% if (locals.matchedMembers && matchedMembers.length > 0) { %>
            <div class="mb-5">
                <h3 class="fw-bold mb-3" style="color: #046957;">
                    <i class="fas fa-user-check me-2"></i>Matching Member Profiles (<%= matchedMembers.length %>)
                </h3>
                <div class="row row-cols-1 row-cols-sm-2 row-cols-md-3 row-cols-lg-4 g-4">
                    <% matchedMembers.forEach(member => { %>
                        <div class="col">
                            <div class="card h-100 shadow-sm border-0 d-flex flex-column" style="border-radius: 10px; transition: transform 0.2s;" onmouseover="this.style.transform='translateY(-4px)'" onmouseout="this.style.transform='translateY(0)'">
                                <div class="card-body text-center p-3">
                                    <img src="<%= member.profilePhoto || '/images/no-profile.svg' %>" alt="Profile" class="rounded-circle shadow-sm mb-2" style="width: 70px; height: 70px; object-fit: cover; border: 2px solid #046957;">
                                    <h6 class="fw-bold text-dark mb-1"><%= member.fullName %></h6>
                                    
                                    <div class="mb-2">
                                        <span class="badge border text-dark fw-normal bg-light"><%= member.relation %></span>
                                        <% if (member.occupation) { %>
                                            <span class="badge text-white fw-normal" style="background-color: #046957;"><%= member.occupation %></span>
                                        <% } %>
                                    </div>

                                    <div class="small text-muted text-start mb-2">
                                        <% if (member.phone) { %>
                                            <div><i class="fas fa-phone me-1 text-secondary"></i> <%= member.phone %></div>
                                        <% } %>
                                        <% if (member.education) { %>
                                            <div><i class="fas fa-graduation-cap me-1 text-secondary"></i> <%= member.education %></div>
                                        <% } %>
                                        <% if (member.address && member.address.suburb) { %>
                                            <div class="text-success fw-semibold"><i class="fas fa-building me-1"></i> <%= member.address.suburb %></div>
                                        <% } %>
                                        <% if (member.address && member.address.city) { %>
                                            <div><i class="fas fa-map-marker-alt me-1 text-secondary"></i> <%= member.address.city %></div>
                                        <% } %>
                                    </div>
                                </div>
                                <div class="card-footer bg-light border-top p-2 text-center mt-auto">
                                    <% if (member.family) { %>
                                        <a href="/family/<%= member.family._id %>" class="btn btn-sm text-white fw-semibold w-100" style="background-color: #046957; border-radius: 6px;">
                                            <i class="fas fa-users me-1"></i> View Family (#<%= member.family.vastipatrakNo %>)
                                        </a>
                                    <% } %>
                                </div>
                            </div>
                        </div>
                    <% }) %>
                </div>
            </div>
        <% } %>
    <% } %>

    <!-- Families Directory Header -->
    <h3 class="fw-bold mb-3" style="color: #046957;">
        <i class="fas fa-home me-2"></i>Family Directory Cards
    </h3>

    <!-- Family Grid -->
    <div class="row g-4 mb-5">
        <% if (locals.families && families.length > 0) { %>
            <% families.forEach(family => { %>
                <div class="col-lg-4 col-md-6 col-12">
                    <div class="card h-100 border-0 shadow-sm" style="transition: transform 0.2s ease-in-out; border-radius: 10px;" onmouseover="this.style.transform='translateY(-5px)'" onmouseout="this.style.transform='translateY(0)'">
                        <div class="card-body text-center p-4">
                            <div class="display-6 fw-bold mb-2" style="color: #046957;"><%= family.vastipatrakNo %></div>
                            <h5 class="fw-bold text-dark mb-1"><%= family.familyHead %></h5>
                            <p class="text-muted mb-3"><%= family.village %> &bull; <%= family.mosal || 'N/A' %></p>
                            
                            <div class="d-flex justify-content-center gap-3 mb-4 text-secondary small">
                                <div><i class="fas fa-users me-1"></i> <%= family.totalMembers %> Members</div>
                            </div>
                            
                            <a href="/family/<%= family._id %>" class="btn btn-outline-success w-100 fw-semibold" style="border-color: #046957; color: #046957;">View Family Details</a>
                        </div>
                    </div>
                </div>
            <% }) %>
        <% } else { %>
            <div class="col-12 text-center text-muted py-5">
                <i class="fas fa-search fa-3x mb-3 text-secondary opacity-50"></i>
                <h5>No matching results found</h5>
                <p>Try searching with another keyword like "engineer", "doctor", a village, or suburb name.</p>
            </div>
        <% } %>
    </div>

    <!-- Pagination -->
    <% if (locals.totalPages && totalPages > 1) { %>
        <nav aria-label="Vastipatrak Pagination">
            <ul class="pagination justify-content-center">
                <li class="page-item <%= currentPage === 1 ? 'disabled' : '' %>">
                    <a class="page-link text-dark" href="/vastipatrak?page=<%= currentPage - 1 %><%= locals.search ? '&search='+encodeURIComponent(search) : '' %>">Previous</a>
                </li>
                <% for(let i = 1; i <= totalPages; i++) { %>
                    <li class="page-item <%= currentPage === i ? 'active' : '' %>">
                        <a class="page-link" href="/vastipatrak?page=<%= i %><%= locals.search ? '&search='+encodeURIComponent(search) : '' %>" <%= currentPage === i ? 'style="background-color: #046957; border-color: #046957; color: white;"' : 'style="color: #046957;"' %>><%= i %></a>
                    </li>
                <% } %>
                <li class="page-item <%= currentPage === totalPages ? 'disabled' : '' %>">
                    <a class="page-link text-dark" href="/vastipatrak?page=<%= currentPage + 1 %><%= locals.search ? '&search='+encodeURIComponent(search) : '' %>">Next</a>
                </li>
            </ul>
        </nav>
    <% } %>
</div>
