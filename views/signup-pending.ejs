<div class="container py-5">
  <div class="row justify-content-center">
    <div class="col-md-7">
      <div class="card border-0 shadow" style="border-radius: 16px; overflow: hidden;">
        
        <!-- Header -->
        <div class="text-center py-4 px-3" style="background: linear-gradient(135deg, #046957 0%, #068a6e 100%);">
          <div class="mb-3">
            <div class="d-inline-flex align-items-center justify-content-center rounded-circle" style="width: 80px; height: 80px; background: rgba(255,255,255,0.15); backdrop-filter: blur(10px);">
              <i class="fas fa-clock fa-2x text-white"></i>
            </div>
          </div>
          <h3 class="text-white fw-bold mb-1">Registration Submitted!</h3>
          <p class="text-white-50 mb-0 small">Your request is being reviewed</p>
        </div>

        <!-- Body -->
        <div class="card-body p-4 p-md-5 text-center">
          
          <!-- Status Badge -->
          <div class="mb-4">
            <span class="badge rounded-pill px-4 py-2 fw-bold" style="background-color: #FFF3CD; color: #856404; font-size: 0.85rem;">
              <i class="fas fa-hourglass-half me-1"></i> Pending Admin Approval
            </span>
          </div>

          <h5 class="fw-bold mb-3" style="color: #333;">
            Thank you, <span style="color: #046957;"><%= applicantName %></span>!
          </h5>

          <p class="text-muted mb-4" style="line-height: 1.7; max-width: 450px; margin: 0 auto;">
            Your registration has been received and is now awaiting approval from the community admin. 
            This is to ensure that only genuine community members can access the directory.
          </p>

          <!-- Info Steps -->
          <div class="text-start mx-auto mb-4" style="max-width: 400px;">
            <div class="d-flex align-items-start mb-3">
              <div class="rounded-circle d-flex align-items-center justify-content-center flex-shrink-0 me-3" style="width: 36px; height: 36px; background: #e8f5f1;">
                <i class="fas fa-check" style="color: #046957; font-size: 14px;"></i>
              </div>
              <div>
                <div class="fw-bold small" style="color: #333;">Registration Complete</div>
                <div class="text-muted" style="font-size: 0.8rem;">Your details have been saved</div>
              </div>
            </div>
            <div class="d-flex align-items-start mb-3">
              <div class="rounded-circle d-flex align-items-center justify-content-center flex-shrink-0 me-3" style="width: 36px; height: 36px; background: #FFF3CD;">
                <i class="fas fa-hourglass-half" style="color: #856404; font-size: 14px;"></i>
              </div>
              <div>
                <div class="fw-bold small" style="color: #333;">Admin Review</div>
                <div class="text-muted" style="font-size: 0.8rem;">The admin has been notified and will review your request</div>
              </div>
            </div>
            <div class="d-flex align-items-start">
              <div class="rounded-circle d-flex align-items-center justify-content-center flex-shrink-0 me-3" style="width: 36px; height: 36px; background: #f0f0f0;">
                <i class="fas fa-envelope" style="color: #888; font-size: 14px;"></i>
              </div>
              <div>
                <div class="fw-bold small" style="color: #333;">Email Notification</div>
                <div class="text-muted" style="font-size: 0.8rem;">You'll receive an email once your account is approved</div>
              </div>
            </div>
          </div>

          <hr class="my-4">

          <a href="/" class="btn fw-semibold text-white px-4 py-2" style="background-color: #046957; border-radius: 8px;">
            <i class="fas fa-home me-2"></i>Back to Home
          </a>
        </div>
      </div>
    </div>
  </div>
</div>
