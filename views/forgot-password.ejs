<div class="container py-5">
    <div class="card mx-auto shadow border-0" style="max-width: 450px; border-radius: 10px; overflow: hidden;">
        <div class="card-header text-white text-center py-3" style="background-color: #046957;">
            <h4 class="mb-0 fw-bold"><i class="fas fa-unlock-alt me-2"></i> Forgot Password</h4>
            <p class="mb-0 small opacity-75 mt-1">Enter your registered email to receive a reset OTP</p>
        </div>
        <div class="card-body p-4 bg-white">
            <% if (locals.errors && errors.length > 0) { %>
                <% errors.forEach(err => { %>
                    <div class="alert alert-danger py-2 small"><i class="fas fa-exclamation-circle me-1"></i><%= err.msg || err %></div>
                <% }) %>
            <% } %>
            <% if (locals.success) { %>
                <div class="alert alert-success py-2 small"><i class="fas fa-check-circle me-1"></i><%= success %></div>
            <% } %>

            <div class="text-center mb-4">
                <div class="d-inline-flex align-items-center justify-content-center rounded-circle" style="width: 70px; height: 70px; background: rgba(4,105,87,0.1);">
                    <i class="fas fa-envelope-open-text fa-2x" style="color: #046957;"></i>
                </div>
            </div>

            <form action="/forgot-password" method="POST">
                <div class="mb-4">
                    <label class="form-label fw-semibold text-muted">Email Address</label>
                    <div class="input-group">
                        <span class="input-group-text bg-light"><i class="fas fa-envelope text-secondary"></i></span>
                        <input type="email" name="email" class="form-control" required placeholder="name@example.com" value="<%= locals.data && data.email ? data.email : '' %>">
                    </div>
                    <div class="form-text text-muted small mt-1">We'll send a 6-digit OTP to this email</div>
                </div>
                
                <button type="submit" class="btn text-white w-100 py-2 fw-bold" style="background-color: #046957;">
                    <i class="fas fa-paper-plane me-2"></i>Send OTP
                </button>
            </form>
            
            <div class="text-center mt-4">
                <a href="/login" class="text-decoration-none" style="color: #046957;">
                    <i class="fas fa-arrow-left me-1"></i> Back to Login
                </a>
            </div>
        </div>
    </div>
</div>
