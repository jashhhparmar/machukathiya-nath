<div class="container py-5">
    <div class="card mx-auto shadow border-0" style="max-width: 450px; border-radius: 10px; overflow: hidden;">
        <div class="card-header text-white text-center py-3" style="background-color: #046957;">
            <h4 class="mb-0 fw-bold"><i class="fas fa-lock me-2"></i> Reset Password</h4>
            <p class="mb-0 small opacity-75 mt-1">Create a new secure password for your account</p>
        </div>
        <div class="card-body p-4 bg-white">
            <% if (locals.errors && errors.length > 0) { %>
                <% errors.forEach(err => { %>
                    <div class="alert alert-danger py-2 small"><i class="fas fa-exclamation-circle me-1"></i><%= err.msg || err %></div>
                <% }) %>
            <% } %>

            <div class="text-center mb-4">
                <div class="d-inline-flex align-items-center justify-content-center rounded-circle" style="width: 70px; height: 70px; background: rgba(4,105,87,0.1);">
                    <i class="fas fa-user-lock fa-2x" style="color: #046957;"></i>
                </div>
                <p class="text-muted small mt-3">OTP verified successfully! Set your new password below.</p>
            </div>

            <form action="/reset-password" method="POST">
                <input type="hidden" name="email" value="<%= locals.email || '' %>">
                
                <div class="mb-3">
                    <label class="form-label fw-semibold text-muted">New Password</label>
                    <div class="input-group">
                        <span class="input-group-text bg-light"><i class="fas fa-lock text-secondary"></i></span>
                        <input type="password" name="password" class="form-control" required placeholder="Minimum 6 characters" minlength="6">
                    </div>
                </div>
                
                <div class="mb-4">
                    <label class="form-label fw-semibold text-muted">Confirm New Password</label>
                    <div class="input-group">
                        <span class="input-group-text bg-light"><i class="fas fa-check-circle text-secondary"></i></span>
                        <input type="password" name="confirmPassword" class="form-control" required placeholder="Re-enter your password" minlength="6">
                    </div>
                </div>
                
                <button type="submit" class="btn text-white w-100 py-2 fw-bold" style="background-color: #046957;">
                    <i class="fas fa-save me-2"></i>Reset Password
                </button>
            </form>
            
            <div class="text-center mt-4">
                <a href="/login" class="text-decoration-none text-muted small">
                    <i class="fas fa-arrow-left me-1"></i> Back to Login
                </a>
            </div>
        </div>
    </div>
</div>
